{
  "name": "budou-bp-h5",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "dev:cloudflare": "npm run build && wrangler dev --local --ip 0.0.0.0 --port 8788",
    "deploy": "npm run build && wrangler deploy",
    "build:pages": "npm run build && node scripts/build-pages.mjs",
    "deploy:pages": "npm run build:pages && wrangler pages deploy --cwd pages --branch master",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "server": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "data:sync": "node scripts/sync-catalog.mjs",
    "test:catalog": "node --test tests/catalog.test.mjs",
    "test:order": "node --import tsx --test tests/catalog-order.test.ts",
    "test:cloudflare-room": "node --test tests/cloudflare-room.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@lucide/vue": "^1.34.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "express": "latest",
    "html2canvas": "latest",
    "tsx": "^4.20.0",
    "vue": "^3.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "@playwright/test": "^1.63.0",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/ws": "latest",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vue-tsc": "^3.1.0",
    "wrangler": "^4.135.0"
  }
}
